      "css": ":host{--bg:#fff8ef;--card:#fff;--ink:#23302f;--muted:#566563;--line:#eadfce;--teal:#1c8576;--teal-ink:#17766a;--on-teal:#fff;--coral:#ff7a5c;--coral-ink:#a8331a;--sun-bg:#fff1c9;--sun-ink:#6b4c00;--ring:#0b5fff}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 14px;border:2px solid var(--teal);border-radius:12px;font:800 14px Nunito,ui-rounded,system-ui,sans-serif;cursor:pointer;white-space:nowrap;background:var(--teal);color:var(--on-teal)}.ds-btn:hover{filter:brightness(1.08)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--ring);outline-offset:3px;border-radius:8px}"
