      "name": "Needs-You Row",
      "kind": "card",
      "refersTo": "item-row",
      "description": "Neutral card with a coral-ink problem line and coral outline button.",
      "html": "<div class=\"ds-item\"><span class=\"ds-tile\">BE</span><div class=\"ds-what\"><h3>The Bear</h3><p class=\"ds-prob\">Could not find a good copy yet</p></div><button class=\"ds-btn-coral\">Try again</button></div>",
      "css": ":host{--bg:#fff8ef;--card:#fff;--ink:#23302f;--muted:#566563;--line:#eadfce;--teal:#1c8576;--teal-ink:#17766a;--on-teal:#fff;--coral:#ff7a5c;--coral-ink:#a8331a;--sun-bg:#fff1c9;--sun-ink:#6b4c00;--ring:#0b5fff}.ds-item{display:flex;gap:12px;align-items:center;background:var(--card);border:2px solid var(--line);border-radius:18px;padding:12px;color:var(--ink);font:500 15px Nunito,ui-rounded,system-ui,sans-serif}.ds-what{flex:1;min-width:0}.ds-what h3{margin:0;font-size:16px;font-weight:800}.ds-prob{margin:0;color:var(--coral-ink);font-weight:700;font-size:14px}.ds-tile{width:46px;height:68px;border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:800;background:linear-gradient(#d1573a,#7a2a1c)}.ds-btn-coral{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 14px;border:2px solid var(--teal);border-radius:12px;font:800 14px Nunito,ui-rounded,system-ui,sans-serif;cursor:pointer;white-space:nowrap;background:transparent;border-color:var(--coral);color:var(--coral-ink)}"
