    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Pinned top-of-page search with the one solid drop.",
      "html": "<form class=\"ds-search\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg><input placeholder=\"Find a movie or show\"></form>",
      "css": ":host{--bg:#fff8ef;--card:#fff;--ink:#23302f;--muted:#566563;--line:#eadfce;--teal:#1c8576;--teal-ink:#17766a;--on-teal:#fff;--coral:#ff7a5c;--coral-ink:#a8331a;--sun-bg:#fff1c9;--sun-ink:#6b4c00;--ring:#0b5fff}.ds-search{display:flex;align-items:center;gap:10px;background:var(--card);border:2px solid var(--line);border-radius:18px;padding:0 16px;min-height:56px;box-shadow:0 5px 0 var(--line);font:500 15px Nunito,ui-rounded,system-ui,sans-serif;color:var(--ink)}.ds-search:focus-within{outline:3px solid var(--ring);outline-offset:3px}.ds-ic{width:22px;height:22px;fill:none;stroke:var(--teal);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.ds-search input{flex:1;border:0;background:none;outline:0;font:600 17px inherit;font-family:inherit;padding:14px 0;color:var(--ink)}.ds-search input::placeholder{color:var(--muted);opacity:1;font-weight:500}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Teal fill for Add and Watch.",
